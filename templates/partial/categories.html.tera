{% macro input(items)%}
<div class="mb-2">
  <div class="is-size-7 has-text-weight-semibold has-text-grey">Categories</div>
  <div class="tags mt-1">
    {% if items | length == 0 %}<span class="taxonomy-empty">カテゴリ未設定</span>{% endif %}
    {% for category in items %}
      <a class="tag is-info is-light" href="{{ category.url }}">{{ category.name }}</a>
    {% endfor %}
  </div>
</div>
{% endmacro %}
