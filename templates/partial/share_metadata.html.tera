  {% if metadata %}
  {% if metadata.description %}<meta name="description" content="{{ metadata.description | escape | safe }}">{% endif %}
  <meta property="og:type" content="{{ metadata.kind }}">
  <meta property="og:title" content="{{ metadata.title | escape | safe }}">
  {% if metadata.description %}<meta property="og:description" content="{{ metadata.description | escape | safe }}">{% endif %}
  <meta property="og:site_name" content="{{ metadata.site_name | escape | safe }}">
  {% if metadata.url %}
  <link rel="canonical" href="{{ metadata.url | escape | safe }}">
  <meta property="og:url" content="{{ metadata.url | escape | safe }}">
  {% endif %}
  {% if metadata.image %}<meta property="og:image" content="{{ metadata.image | escape | safe }}">
  <meta name="twitter:card" content="summary_large_image">{% endif %}
  {% endif %}
