<!doctype html>
<html lang="ja">
<head>
  {% block head %}
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ site_name | default(value="My Blog") }}{% endblock title %}</title>
  {% if metadata is defined %}
  <meta name="description" content="{{ metadata.description | escape | safe }}">
  <meta property="og:type" content="article">
  <meta property="og:title" content="{{ metadata.title | escape | safe }}">
  <meta property="og:description" content="{{ metadata.description | escape | safe }}">
  <meta property="og:site_name" content="{{ site_name | default(value="My Blog") | escape | safe }}">
  {% if metadata.url %}
  <link rel="canonical" href="{{ metadata.url | escape | safe }}">
  <meta property="og:url" content="{{ metadata.url | escape | safe }}">
  {% endif %}
  {% if metadata.image %}<meta property="og:image" content="{{ metadata.image | escape | safe }}">{% endif %}
  {% endif %}
  <link rel="stylesheet" href="/css/bulma.min.css">
  <link rel="stylesheet" href="/css/site.css">
  <link rel="shortcut icon" href= "{{ favicon_path }}" >
  {% endblock head %}
</head>
<body>
  <nav class="navbar is-light" role="navigation" aria-label="main navigation">
    <div class="container">
      <div class="navbar-brand">
        <a class="navbar-item has-text-weight-semibold" href="/">記事一覧</a>
        <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="mainNav">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </a>
      </div>

      <div id="mainNav" class="navbar-menu">
        <div class="navbar-start">
          <a class="navbar-item" href="{{ tags_url | default(value='/tags') }}">Tags</a>
          <a class="navbar-item" href="{{ categories_url | default(value='/categories') }}">Categories</a>
          <a class="navbar-item" href="{{ about_url | default(value='/about') }}">About</a>
        </div>
      </div>
    </div>
  </nav>
  <section class="section">
    <div class="container">
      {% block content %}{% endblock content %}
    </div>
  </section>
  <footer class="footer">
    <div class="content has-text-centered">
      <p>© {{ year | default(value=2025) }} {{ site_name }} </p>
    </div>
  </footer>
  {% block scripts %}
  <script src="/js/nav.js?v=2" defer></script>
  {% endblock scripts %}
</body>
</html>
