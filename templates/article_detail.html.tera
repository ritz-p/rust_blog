{% extends "partial/base" %}
{% import "partial/tags" as tags_macro %}
{% import "partial/categories" as categories_macro%}
{% block title %}{{ title }}{% endblock title %}

{% block head %}
  {% if article_meta_csp %}<meta http-equiv="Content-Security-Policy" content="{{ article_meta_csp }}">{% endif %}
  {{ super() }}
  {% if article_ads %}
  <script src="/js/adsense.js" integrity="{{ article_ads.script_integrity | safe }}"
          data-ad-client="{{ article_ads.publisher_id }}"{% if article_ads.sidebar_slot %} data-sidebar{% endif %} defer></script>
  {% endif %}
{% endblock head %}

{% block content %}
<div class="columns">
  <div class="column is-8">
    <article class="article-page" aria-labelledby="post-title">
      {% include "partial/article_header" %}
      {% if deprecated %}
      <aside class="notification article-deprecated" role="note"{% if pending_successor_url %} data-pending-successor="{{ pending_successor_url }}"{% endif %}>この記事の内容は古いです{% if successor %}。後継記事「<a href="{{ successor.url }}">{{ successor.title }}</a>」をご覧ください。{% endif %}</aside>
      {% endif %}
      <div class="content is-medium">
        {{ content_html | safe }}
      </div>
      <hr>
      {{ categories_macro::input(items=categories) }}
      {{ tags_macro::input(items=tags) }}
      <hr>
      <nav class="article-adjacent" aria-label="記事の移動">
        {% for item in adjacent %}<a href="{{ item.url }}"><small>{{ item.label }}</small>{{ item.title }}</a>{% endfor %}
      </nav>
      <nav class="level">
        <div class="level-left">
          <a class="button is-light" data-return-listing href="{% if listing %}{{ listing.url }}{% else %}/{% endif %}">← {% if listing %}{{ listing.label }}の{% endif %}一覧へ</a>
        </div>
      </nav>
    </article>
  </div>
  {% include "partial/sidemenu" %}
</div>
{% endblock content %}
