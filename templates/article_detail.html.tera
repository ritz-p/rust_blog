{% extends "partial/base" %}
{% import "partial/tags" as tags_macro %}
{% import "partial/categories" as categories_macro%}
{% block title %}{{ title }}{% endblock title %}

{% block content %}
<div class="columns">
  <div class="column is-8">
    <article class="article-page" aria-labelledby="post-title">
      <header class="article-header">
        <h1 id="post-title" class="title is-2">{{ title }}</h1>
        <dl class="article-dates">
          <div><dt>公開日</dt><dd>{{ created_at }}</dd></div>
          {% if updated_at %}
          <div class="date-updated"><dt><span class="date-separator" aria-hidden="true">/</span>更新日</dt><dd>{{ updated_at }}</dd></div>
          {% endif %}
        </dl>
      </header>
      <div class="content is-medium">
        {{ content_html | safe }}
      </div>
      <hr>
      {{ categories_macro::input(items=categories) }}
      {{ tags_macro::input(items=tags) }}
      <hr>
      <nav class="level">
        <div class="level-left">
          <a class="button is-light" href="/">← 一覧へ</a>
        </div>
      </nav>
    </article>
  </div>
  {% include "partial/sidemenu" %}
</div>
{% endblock content %}
